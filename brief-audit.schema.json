{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_sha256",
    "approve",
    "issues"
  ],
  "properties": {
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approve": {
      "type": "boolean"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      },
      "maxItems": 12
    }
  }
}
